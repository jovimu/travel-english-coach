<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Travel English AI Coach ✈️</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    .pulse-mic { animation: micPulse 1.2s infinite; }
    @keyframes micPulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { transform: scale(1.08); box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .audio-wave {
      display: inline-block; width: 3px; height: 12px; background-color: #3b82f6;
      margin: 0 1px; border-radius: 2px; animation: wave 1s infinite ease-in-out;
    }
    @keyframes wave { 0%, 100% { height: 4px; } 50% { height: 16px; } }
    .audio-wave:nth-child(2) { animation-delay: 0.2s; }
    .audio-wave:nth-child(3) { animation-delay: 0.4s; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-600 selection:text-white">

  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-30">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-gradient-to-tr from-blue-600 to-indigo-500 rounded-xl shadow-lg">
          <i class="fa-solid fa-plane-departure text-xl text-white"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-tight text-white">Travel English AI Coach</h1>
          <p class="text-xs text-slate-400">Entrenador Conversacional con Fotos Reales & Soporte Móvil</p>
        </div>
      </div>

      <!-- Selector Destino -->
      <div class="flex items-center space-x-2 bg-slate-950 p-1 rounded-xl border border-slate-800">
        <button id="btn-dest-us" onclick="setDestination('US')" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white">🇺🇸 EE.UU. (US)</button>
        <button id="btn-dest-uk" onclick="setDestination('UK')" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">🇬🇧 Londres (UK)</button>
      </div>

      <!-- Navegación y Configuración -->
      <div class="flex items-center space-x-1">
        <button onclick="switchTab('chat')" id="tab-btn-chat" class="px-3 py-2 rounded-lg text-xs font-medium bg-slate-800 text-blue-400 border border-slate-700"><i class="fa-solid fa-comments"></i> Simulador</button>
        <button onclick="switchTab('phrases')" id="tab-btn-phrases" class="px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white"><i class="fa-solid fa-book-open"></i> Frases Útiles</button>
        <button onclick="switchTab('guide')" id="tab-btn-guide" class="px-3 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white"><i class="fa-solid fa-compass"></i> Guía Cultural</button>
        <button onclick="toggleSettings()" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs ml-2" title="Ajustes de API"><i class="fa-solid fa-gear"></i></button>
      </div>
    </div>
  </header>

  <!-- Banner Advertencia HTTPS -->
  <div id="mobileHttpsBanner" class="hidden bg-amber-500/10 border-b border-amber-500/30 px-4 py-2 text-xs text-amber-300 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <i class="fa-solid fa-triangle-exclamation text-amber-400"></i>
      <span><strong>Aviso Móvil:</strong> Para usar el micrófono en el móvil debes abrir este archivo mediante <strong>HTTPS</strong>.</span>
    </div>
    <button onclick="document.getElementById('mobileHttpsBanner').remove()" class="text-amber-400 font-bold px-2">✕</button>
  </div>

  <!-- Modal Ajustes API Gemini -->
  <div id="settingsModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl max-w-md w-full shadow-2xl relative">
      <h3 class="text-lg font-bold mb-2 text-white flex items-center"><i class="fa-solid fa-key text-amber-400 mr-2"></i> Clave API Gemini</h3>
      <p class="text-xs text-slate-400 mb-4">Ingresa tu clave de Gemini para obtener respuestas conversacionales avanzadas. Si la dejas en blanco, funcionará en modo local inteligente.</p>
      <input type="password" id="apiKeyInput" placeholder="Pega tu clave AIzaSy..." class="w-full p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-sm text-white mb-4 focus:outline-none focus:border-blue-500">
      <div class="flex justify-between items-center">
        <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-xs text-blue-400 hover:underline">Obtener clave gratis</a>
        <div class="flex space-x-2">
          <button onclick="toggleSettings()" class="px-3.5 py-1.5 bg-slate-800 text-slate-300 rounded-xl text-xs">Cerrar</button>
          <button onclick="saveSettings()" class="px-4 py-1.5 bg-blue-600 text-white rounded-xl text-xs">Guardar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenedor Principal Chat -->
  <div id="tab-content-chat" class="max-w-6xl w-full mx-auto p-3 sm:p-4 flex-1 flex flex-col md:flex-row gap-4">
    <!-- Lateral Escenarios -->
    <aside class="w-full md:w-72 space-y-2 flex-shrink-0">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 px-2 py-1 flex justify-between">
        <span>Escenarios de Viaje</span>
        <span id="dest-badge" class="text-[10px] text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-full border border-blue-500/20">EE.UU. 🇺🇸</span>
      </p>
      <div id="scenarios-container" class="space-y-1.5 max-h-[220px] md:max-h-[560px] overflow-y-auto pr-1"></div>
    </aside>

    <!-- Chat Box -->
    <section class="flex-1 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col h-[580px] sm:h-[650px] overflow-hidden shadow-xl">
      <!-- Encabezado Avatar -->
      <div class="bg-slate-950 border-b border-slate-800 p-3 flex items-center space-x-4">
        <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border-2 border-slate-700 flex-shrink-0 bg-slate-900 shadow-md">
          <img id="avatarImg" src="" alt="Avatar Humano Real" class="w-full h-full object-cover relative z-0 transition-all duration-300">
          <canvas id="lipCanvas" width="120" height="120" class="absolute inset-0 w-full h-full object-cover z-10 pointer-events-none"></canvas>
          <div id="speechPulse" class="hidden absolute bottom-1 right-1 bg-emerald-500 w-3.5 h-3.5 rounded-full border-2 border-slate-950 animate-ping z-20"></div>
        </div>

        <div class="flex-1 min-w-0">
          <div class="flex items-center space-x-2 mb-1">
            <h2 id="avatarTitle" class="font-bold text-sm sm:text-base text-white truncate">Agente de Embarque</h2>
            <span id="avatarTag" class="text-[10px] bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2 py-0.5 rounded-full">JFK Terminal 4</span>
          </div>
          <p id="avatarSubtitle" class="text-xs text-slate-400 truncate mb-2">Facturación & Equipaje • JFK Terminal 4</p>
          <div id="audioStatus" class="flex items-center space-x-2 text-xs text-slate-400">
            <span class="text-[11px]"><i class="fa-solid fa-volume-high text-blue-400 mr-1"></i> Audio y respuesta listos</span>
          </div>
        </div>

        <button onclick="repeatLastBotMessage()" class="p-2 text-slate-400 hover:text-white bg-slate-900 border border-slate-800 rounded-xl text-xs" title="Repetir audio"><i class="fa-solid fa-rotate-right"></i></button>
      </div>

      <!-- Chat Messages -->
      <div id="chatBox" class="flex-1 p-4 overflow-y-auto space-y-4 bg-slate-950/40"></div>

      <!-- Alerta Error de API o Micrófono -->
      <div id="statusAlert" class="hidden mx-4 mb-2 p-2.5 bg-amber-500/10 border border-amber-500/30 rounded-xl text-xs text-amber-300 flex items-center justify-between">
        <span id="statusAlertMsg"><i class="fa-solid fa-circle-exclamation mr-1.5"></i> Alerta</span>
        <button onclick="document.getElementById('statusAlert').classList.add('hidden')" class="text-amber-400 font-bold px-1">✕</button>
      </div>

      <!-- Banner Feedback -->
      <div id="feedbackBanner" class="hidden mx-4 mb-2 p-3 bg-slate-900/90 border border-amber-500/30 rounded-xl text-xs space-y-1.5 shadow-lg">
        <div class="font-bold text-amber-400 flex items-center justify-between border-b border-slate-800 pb-1">
          <span class="flex items-center"><i class="fa-solid fa-wand-magic-sparkles mr-1.5"></i> Corrección & Análisis de Expresión</span>
        </div>
        <div class="space-y-1 text-slate-300 pt-0.5">
          <p id="feedbackOriginal" class="text-rose-300"><span class="font-semibold text-rose-400">❌ Dijiste:</span> "-"</p>
          <p id="feedbackNatural" class="text-emerald-300"><span class="font-semibold text-emerald-400">✅ Opción Natural:</span> "-"</p>
          <p id="feedbackExplanation" class="text-slate-300 italic"><span class="font-semibold text-amber-400 not-italic">💡 Explicación:</span> "-"</p>
        </div>
      </div>

      <!-- Controles de Entrada -->
      <div class="p-3 bg-slate-900 border-t border-slate-800 flex items-center space-x-2">
        <button id="micBtn" onclick="toggleSpeech()" class="p-3 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl transition border border-slate-700 flex items-center justify-center min-w-[48px] touch-manipulation">
          <i id="micIcon" class="fa-solid fa-microphone text-lg"></i>
        </button>
        <input type="text" id="userInput" placeholder="Escribe o habla en inglés aquí..." class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500 text-white">
        <button onclick="sendMessage()" class="p-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-medium transition flex items-center justify-center min-w-[48px] touch-manipulation">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
      </div>

      <div class="px-4 py-1 bg-slate-950 border-t border-slate-900 flex justify-between items-center text-[10px] text-slate-500">
        <span id="aiStatusIndicator"><i class="fa-solid fa-circle text-[8px] text-amber-500 mr-1"></i> Modo Simulado Local Activo</span>
        <span class="font-mono">Studio Photo Avatars & Mobile Mic Ready</span>
      </div>
    </section>
  </div>

  <!-- Pestaña Frases Útiles -->
  <div id="tab-content-phrases" class="hidden max-w-6xl w-full mx-auto p-4 flex-1">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
      <h2 class="text-lg font-bold text-white mb-4"><i class="fa-solid fa-book-open text-blue-400 mr-2"></i> Guía de Frases Imprescindibles</h2>
      <div id="phrasesGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
    </div>
  </div>

  <!-- Pestaña Guía Cultural -->
  <div id="tab-content-guide" class="hidden max-w-6xl w-full mx-auto p-4 flex-1">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
      <h2 class="text-lg font-bold text-white"><i class="fa-solid fa-compass text-amber-400 mr-2"></i> Consejos de Viaje y Cultura</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-slate-300">
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-blue-400 text-sm">✈️ En el Aeropuerto y Control</h3>
          <p>Ten siempre tu pasaporte y billete de embarque a mano. En inglés aeroportuario se utiliza <strong>Gate</strong> para la puerta de embarque en lugar de <em>finger</em>.</p>
        </div>
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">🏥 En Urgencias y Salud</h3>
          <p>Para describir síntomas usa <em>"I have a..."</em> (fever, headache, sore throat) o <em>"I feel..."</em> (dizzy, nauseous).</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const DESTINATIONS = {
      US: {
